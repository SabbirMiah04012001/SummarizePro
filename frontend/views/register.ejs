<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - SummarizePro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="login-wrapper">
        <div class="login-branding">
            <div class="orbit" aria-hidden="true">
                <span class="orbit-glow"></span>
                <span class="orbit-ring"></span>
                <span class="brand-mark">S</span>
                <span class="orbit-track">
                    <span class="orbit-slot slot-pdf">
                        <span class="orbit-icon">
                            <svg viewBox="0 0 24 24"><path d="M7 3.5h7l5 5V20H7z"/><path d="M14 3.5V9h5"/></svg>
                        </span>
                    </span>
                    <span class="orbit-slot slot-quiz">
                        <span class="orbit-icon">
                            <svg viewBox="0 0 24 24"><path d="M6 4.5h12v15H6z"/><path d="M9 9h6M9 12.5h6M9 16h3"/></svg>
                        </span>
                    </span>
                    <span class="orbit-slot slot-phone">
                        <span class="orbit-icon">
                            <svg viewBox="0 0 24 24"><rect x="8" y="3.5" width="8" height="17" rx="2"/><path d="M11 17.5h2"/></svg>
                        </span>
                    </span>
                    <span class="orbit-slot slot-laptop">
                        <span class="orbit-icon">
                            <svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="10" rx="1.5"/><path d="M3.5 17.5h17"/></svg>
                        </span>
                    </span>
                </span>
            </div>
            <h1>SummarizePro</h1>
        </div>

        <div class="login-form-container">
            <div class="login-card">
                <span class="login-glow" aria-hidden="true"></span>
                <span class="login-border" aria-hidden="true"></span>
                <form class="login-form" action="/register" method="post" onsubmit="return validateForm()">
                    <h2>Register</h2>
                    <% if (typeof message !== 'undefined' && message && message.length) { %>
                        <p style="color: red; text-align: center;"><%= message %></p>
                    <% } %>
                    <div class="form-group">
                        <label for="email">Email:</label>
                        <input type="email" id="email" name="email" required
                            <% if (typeof email !== 'undefined' && email && email.length) { %>
                                value="<%= email %>"
                            <% } %>
                        >
                    </div>
                    <div class="form-group">
                        <label for="password">Password:</label>
                        <input type="password" id="password" name="password" pattern=".{6,}" title="Password must be at least 6 characters long" required oninput="validateForm()">
                    </div>
                    <div class="form-group">
                        <label for="confirm_password">Confirm Password:</label>
                        <input type="password" id="confirm_password" name="confirm_password" required oninput="validateForm()">
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn-login">Register</button>
                    </div>
                    <p class="signup-link">Already a member? <a href="/login">Login here</a></p>
                </form>
            </div>

            <script>
                // Warns the reader when the two passwords do not match.
                function validateForm() {
                    var password = document.getElementById("password").value;
                    var confirm_password = document.getElementById("confirm_password");
                    var confirm_password_label = confirm_password.previousElementSibling;
                    if (password != confirm_password.value) {
                        confirm_password_label.textContent = "Passwords do not match";
                        confirm_password_label.style.color = "#a33b3b";
                        return false;
                    }
                    confirm_password_label.textContent = "Confirm Password:";
                    confirm_password_label.style.color = "";
                    return true;
                }
            </script>
        </div>
    </div>
</body>
</html>
